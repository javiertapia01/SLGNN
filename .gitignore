.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# datos crudos y extraídos: se descargan, no se versionan
data/raw/*
!data/raw/.gitkeep
data/extracted/*
!data/extracted/.gitkeep

*.zip
*.log
*.egg-info/
build/
checkpoints/
# `results/*` y no `results/`: con la barra final git excluye el directorio
# entero y ya no puede reincluir nada de dentro.
results/*

# Excepción: los resúmenes pequeños de SLGNN-v3 SÍ se versionan, porque son la
# evidencia que respalda docs/v3/RESULTS_MVP.md. Los checkpoints (.pt), los
# metrics.jsonl y los directorios por corrida siguen fuera.
!results/v3_mvp/
results/v3_mvp/*
!results/v3_mvp/micro_overfit.json
!results/v3_mvp/audit_temporal/
results/v3_mvp/audit_temporal/*
!results/v3_mvp/audit_temporal/audit.json
!results/v3_mvp/audit_temporal/audit_summary.csv
!results/v3_mvp/compare/
results/v3_mvp/compare/*
!results/v3_mvp/compare/comparison_*.json
